<!DOCTYPE html>
<html lang="<%= locals.currentLang || 'en' %>" dir="<%= (locals.currentLang || 'en') === 'ar' ? 'rtl' : 'ltr' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= locals.title || 'Login' %> - Viora</title>
    <meta name="description" content="Sign in to the Viora dashboard with your Discord account.">

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/viora.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="/js/theme.js"></script>
</head>
<body class="viora-landing viora-auth">
    <div class="viora-landing-bg"></div>
    <div class="viora-landing-grid"></div>

    <a href="/" class="viora-auth-brand" aria-label="Viora">
        <div class="viora-sb-mark">V</div>
        <span class="viora-landing-brand-name">Viora</span>
    </a>

    <%- body %>

    <div class="viora-auth-footer">
        © 2026 Viora
    </div>
</body>
</html>