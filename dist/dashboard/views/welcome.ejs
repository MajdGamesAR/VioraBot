<% const wg = locale.dashboard.welcomeGoodbye; const wgJsonSafe = (x) => JSON.stringify(x).replace(/</g, '\\u003c');
    const wgChannels = typeof channels !== 'undefined' && Array.isArray(channels) ? channels : [];
    const wgChannelOptions = (selectedId) => wgChannels.map((ch) => {
        const esc = String(ch.id).replace(/[&<>"]/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[m]));
        const name = String(ch.name).replace(/[&<>]/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[m]));
        return `<option value="${esc}"${selectedId === ch.id ? ' selected' : ''}>#${name}</option>`;
    }).join(''); %>
