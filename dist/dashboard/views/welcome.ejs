                                <div class="field"><label for="wg-goodbye-adv-text-y"><%= wg.image.text.y %></label><input type="number" step="1" class="viora-input" id="wg-goodbye-adv-text-y" data-section="text" data-key="y"></div>
                                <div class="field"><label for="wg-goodbye-adv-text-fontSize"><%= wg.image.text.fontSize %></label><input type="number" step="1" class="viora-input" id="wg-goodbye-adv-text-fontSize" data-section="text" data-key="fontSize"></div>
                                <div class="field"><label for="wg-goodbye-adv-bg-positionX"><%= wg.image.background.positionX %></label><input type="number" step="1" class="viora-input" id="wg-goodbye-adv-bg-positionX" data-section="background" data-key="positionX"></div>
                                <div class="field"><label for="wg-goodbye-adv-bg-positionY"><%= wg.image.background.positionY %></label><input type="number" step="1" class="viora-input" id="wg-goodbye-adv-bg-positionY" data-section="background" data-key="positionY"></div>
                                <div class="field"><label for="wg-goodbye-adv-bg-scale"><%= wg.image.background.scale %></label><input type="number" step="0.05" class="viora-input" id="wg-goodbye-adv-bg-scale" data-section="background" data-key="scale"></div>
                            </div>
                        </details>
                        <div class="mt-2 hidden" id="wg-goodbye-verify-wrap">
                            <img id="wg-goodbye-verify-img" alt="<%= wg.image.verifyRender %>" class="w-full h-auto block rounded-lg border border-gray-200 dark:border-gray-700">
                        </div>
                        <p class="text-xs text-gray-500 dark:text-gray-400 mt-2"><%= wg.image.previewHint %></p>
                    </div>
                    <div class="rounded-lg bg-gray-50 dark:bg-gray-900 p-4">
                        <div class="editor-tabs" id="wg-editor-tabs-goodbye"></div>
                        <div class="mt-4" id="wg-editor-panels-goodbye"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="save-bar" id="saveBar">
        <div class="save-bar-content">
            <div class="save-bar-text">
                <i class="fas fa-info-circle"></i>
                <span><%= wg.unsavedChanges %></span>
            </div>
            <div class="save-bar-buttons">
                <button class="reset-button" id="wg-reset"><i class="fas fa-undo"></i> <%= wg.resetDefaults %></button>
                <button class="save-button" id="wg-save"><i class="fas fa-save"></i> <%= wg.saveChanges %></button>
            </div>
        </div>
    </div>
</div>

<div id="wgTestModal" class="modal hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-xl p-6 w-full max-w-2xl max-h-[90vh] overflow-y-auto">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-bold text-gray-800 dark:text-white"><%= wg.testResult.title %></h3>
            <button type="button" id="wg-test-close" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 text-xl leading-none">&times;</button>
        </div>
        <div class="flex flex-wrap items-center gap-2 mb-3">
            <select id="wg-test-member" class="input-field text-sm w-auto" aria-label="<%= wg.testResult.memberLabel %>"></select>
            <button type="button" class="reset-button" id="wg-test-run"><i class="fas fa-play"></i> <%= wg.testResult.runTest %></button>
        </div>
        <div class="text-sm text-gray-500 dark:text-gray-400 mb-3"><span id="wg-test-used-label"></span></div>
        <div class="mb-3">
            <div class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-1"><%= wg.testResult.textLabel %></div>
            <div id="wg-test-text" class="p-3 bg-gray-100 dark:bg-gray-900 rounded-lg whitespace-pre-wrap break-words text-gray-800 dark:text-gray-200"></div>
        </div>
        <div>
            <div class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-1"><%= wg.testResult.imageLabel %></div>
            <img id="wg-test-image" alt="<%= wg.testResult.imageLabel %>" class="w-full rounded-lg border border-gray-200 dark:border-gray-700 hidden">
            <div id="wg-test-noimage" class="p-3 bg-gray-100 dark:bg-gray-900 rounded-lg text-sm text-gray-500"><%= wg.testResult.noImage %></div>
        </div>
    </div>
</div>

<div id="wgTemplateModal" class="modal hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-xl p-6 w-full max-w-4xl max-h-[90vh] flex flex-col">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-bold text-gray-800 dark:text-white"><i class="fas fa-images"></i> <%= wg.image.templatesTitle %></h3>
            <button type="button" id="wg-template-modal-close" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 text-xl leading-none">&times;</button>
        </div>
        <div id="wg-template-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 overflow-y-auto"></div>
        <p id="wg-template-loading" class="text-sm text-gray-500 dark:text-gray-400 py-4"><i class="fas fa-spinner fa-spin"></i> <%= wg.image.templatesLoading %></p>
        <div class="mt-4 flex justify-end">
            <button type="button" class="reset-button" id="wg-template-modal-cancel"><%= wg.close %></button>
        </div>
    </div>
</div>

<script>
    window.WELCOME_PAGE = {
        cfg: <%- wgJsonSafe(settings.welcomeGoodbye || null) %>,
        legacy: <%- wgJsonSafe(settings.welcome || null) %>,
        channels: <%- wgJsonSafe(channels) %>,
        members: <%- wgJsonSafe(typeof members !== 'undefined' ? members : []) %>,
        templates: <%- wgJsonSafe(typeof templates !== 'undefined' ? templates : []) %>,
        fonts: <%- wgJsonSafe(typeof fonts !== 'undefined' ? fonts : []) %>,
        locale: <%- wgJsonSafe(wg) %>
    };
</script>