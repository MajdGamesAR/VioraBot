<%- contentFor('body') %>

<div class="space-y-6 p-4 md:p-6 animate-fade-in">
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
        <h2 class="text-2xl font-bold text-gray-800 dark:text-white mb-6"><%= locale.dashboard.warnings.title %></h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6 p-4 bg-gray-50 dark:bg-gray-700/50 rounded-lg">
            <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2"><%= locale.dashboard.warnings.userId %></label>
                <input type="text" id="warningUserId" placeholder="123456789012345678"
                       class="w-full px-3 py-2 bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2"><%= locale.dashboard.warnings.reason %></label>
                <input type="text" id="warningReason" placeholder="<%= locale.dashboard.warnings.reason %>"
                       class="w-full px-3 py-2 bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <div class="flex items-end">
                <button id="addWarningBtn" class="w-full px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition-all">
                    <i class="fas fa-plus mr-2"></i><%= locale.dashboard.warnings.add %>
                </button>
            </div>
        </div>

        <div class="flex gap-2 mb-6">
            <% const statuses = [
                { key: 'all', label: locale.dashboard.warnings.all },
                { key: 'active', label: locale.dashboard.warnings.active },
                { key: 'expired', label: locale.dashboard.warnings.expired }
            ] %>
            <% statuses.forEach(s => { %>
                <button class="warning-filter px-3 py-1.5 rounded-lg text-sm font-medium transition-all <%= s.key === 'all' ? 'active' : '' %>" data-status="<%= s.key %>"><%= s.label %></button>
            <% }) %>
        </div>

        <div id="warningsLoader" class="flex items-center justify-center py-16">
            <div class="h-8 w-8 border-4 border-blue-500 border-t-transparent rounded-full animate-spin"></div>
        </div>
        <div id="warningsEmpty" class="hidden text-center py-16 text-gray-400">
            <i class="fas fa-inbox text-4xl mb-3"></i>
            <p><%= locale.dashboard.warnings.noWarnings %></p>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="text-left text-gray-500 dark:text-gray-400 border-b border-gray-200 dark:border-gray-700">
                        <th class="py-3 px-4"><%= locale.dashboard.warnings.user %></th>
                        <th class="py-3 px-4"><%= locale.dashboard.warnings.moderator %></th>
                        <th class="py-3 px-4"><%= locale.dashboard.warnings.reason %></th>
                        <th class="py-3 px-4"><%= locale.dashboard.warnings.date %></th>
                        <th class="py-3 px-4"><%= locale.dashboard.warnings.expires %></th>
                        <th class="py-3 px-4"><%= locale.dashboard.warnings.status %></th>
                        <th class="py-3 px-4"></th>
                    </tr>
                </thead>
                <tbody id="warningsTableBody">
                    <tr class="text-gray-400 text-center">
                        <td colspan="7" class="py-8"><%= locale.dashboard.warnings.loading %></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div id="removeConfirmModal" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50">
    <div class="bg-white dark:bg-gray-800 rounded-lg p-6 max-w-sm w-full mx-4">
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2"><%= locale.dashboard.warnings.confirmRemove %></h3>
        <p class="text-gray-600 dark:text-gray-400 mb-2 text-sm" id="removeWarningTarget"></p>
        <input type="text" id="removeWarningReason" placeholder="<%= locale.dashboard.warnings.reason %>"
               class="w-full px-3 py-2 mt-2 bg-gray-100 dark:bg-gray-700 rounded-lg border border-gray-300 dark:border-gray-600 focus:outline-none focus:ring-2 focus:ring-blue-500">
        <div class="flex justify-end gap-4 mt-6">
            <button id="removeCancel" class="px-4 py-2 bg-gray-200 dark:bg-gray-700 text-gray-800 dark:text-gray-200 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition-all">Cancel</button>
            <button id="removeConfirm" class="px-4 py-2 bg-red-500 text-white rounded-lg hover:bg-red-600 transition-all"><%= locale.dashboard.warnings.removeWarning %></button>
        </div>
    </div>
</div>