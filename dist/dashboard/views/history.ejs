<%- contentFor('body') %>

<div class="space-y-6 p-4 md:p-6 animate-fade-in">
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
        <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
            <h2 class="text-2xl font-bold text-gray-800 dark:text-white"><%= locale.dashboard.history.title %></h2>
            <div class="flex items-center gap-2">
                <span class="text-xs text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-700 px-3 py-1 rounded-full">
                    <span id="historyTotal">0</span>
                </span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4 mb-6">
            <div class="relative lg:col-span-1">
                <input type="text" id="historySearch" placeholder="<%= locale.dashboard.history.search %>"
                       class="w-full px-4 py-2 bg-gray-100 dark:bg-gray-700 rounded-lg pl-10 focus:outline-none focus:ring-2 focus:ring-blue-500">
                <i class="fas fa-search absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
            </div>
            <select id="historyAction" class="px-3 py-2 bg-gray-100 dark:bg-gray-700 rounded-lg focus:outline-none">
                <option value=""><%= locale.dashboard.history.allActions %></option>
                <% actions.forEach(action => { %>
                    <option value="<%= action %>"><%= locale.dashboard.actionTypes[action] ? locale.dashboard.actionTypes[action] : action %></option>
                <% }) %>
            </select>
            <input type="date" id="historyFrom" class="px-3 py-2 bg-gray-100 dark:bg-gray-700 rounded-lg">
            <input type="date" id="historyTo" class="px-3 py-2 bg-gray-100 dark:bg-gray-700 rounded-lg">
            <button id="historyApply" class="px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition-all">
                <i class="fas fa-filter mr-2"></i><%= locale.dashboard.history.apply %>
            </button>
        </div>

        <div id="historyLoader" class="flex items-center justify-center py-16">
            <div class="h-8 w-8 border-4 border-blue-500 border-t-transparent rounded-full animate-spin"></div>
        </div>

        <div id="historyEmpty" class="hidden text-center py-16 text-gray-400">
            <i class="fas fa-inbox text-4xl mb-3"></i>
            <p><%= locale.dashboard.history.noResults %></p>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="text-left text-gray-500 dark:text-gray-400 border-b border-gray-200 dark:border-gray-700">
                        <th class="py-3 px-4"><%= locale.dashboard.history.date %></th>
                        <th class="py-3 px-4"><%= locale.dashboard.history.action %></th>
                        <th class="py-3 px-4"><%= locale.dashboard.history.user %></th>
                        <th class="py-3 px-4"><%= locale.dashboard.history.moderator %></th>
                        <th class="py-3 px-4"><%= locale.dashboard.history.reason %></th>
                    </tr>
                </thead>
                <tbody id="historyTableBody">
                    <tr class="text-gray-400 text-center">
                        <td colspan="5" class="py-8"><%= locale.dashboard.history.loading %></td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="flex items-center justify-between mt-6">
            <button id="historyPrev" class="px-4 py-2 bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-200 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition-all disabled:opacity-50">
                <i class="fas fa-chevron-left mr-1"></i><%= locale.dashboard.history.prev %>
            </button>
            <span class="text-sm text-gray-500 dark:text-gray-400" id="historyPageInfo"></span>
            <button id="historyNext" class="px-4 py-2 bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-200 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition-all disabled:opacity-50">
                <%= locale.dashboard.history.next %><i class="fas fa-chevron-right ml-1"></i>
            </button>
        </div>
    </div>
</div>